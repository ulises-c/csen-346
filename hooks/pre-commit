#!/usr/bin/env bash
# pre-commit: mirrors the CI lint → test pipeline locally.
# Runs against the entire repo (not just staged files) to match CI behaviour.
set -euo pipefail

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
RESET='\033[0m'

pass() { echo -e "${GREEN}✓${RESET} $*"; }
fail() { echo -e "${RED}✗${RESET} $*"; }
info() { echo -e "${BOLD}→${RESET} $*"; }

# ---------------------------------------------------------------------------
# Step 1: Formatting (ruff format --check)
# ---------------------------------------------------------------------------
info "Checking formatting (ruff format --check) …"
if uvx ruff format --check .; then
  pass "Formatting OK"
else
  fail "Formatting check failed. Run 'ruff format .' to fix."
  exit 1
fi

# ---------------------------------------------------------------------------
# Step 2: Linting (ruff check)
# ---------------------------------------------------------------------------
info "Checking linting (ruff check) …"
if uvx ruff check .; then
  pass "Linting OK"
else
  fail "Linting failed. Run 'ruff check --fix .' to auto-fix where possible."
  exit 1
fi

# ---------------------------------------------------------------------------
# Step 3: Type checking (pyright — mirrors CI lint job)
# ---------------------------------------------------------------------------
info "Type checking (pyright) …"
if uv run --no-sync python -m pyright; then
  pass "Type check OK"
else
  fail "Type check failed. Fix the errors above before committing."
  exit 1
fi

# ---------------------------------------------------------------------------
# Step 4: Spell check (codespell — mirrors CI lint job)
# ---------------------------------------------------------------------------
info "Spell checking (codespell) …"
if uv run --no-sync python -m codespell_lib .; then
  pass "Spell check OK"
else
  fail "Spell check failed. Fix the typos above before committing."
  exit 1
fi

# ---------------------------------------------------------------------------
# Step 5: Shell script linting (shellcheck — mirrors CI lint job)
# NOTE: shellcheck is a native binary; skip gracefully if not installed locally.
# Install: brew install shellcheck  or  apt install shellcheck
# ---------------------------------------------------------------------------
if command -v shellcheck &>/dev/null; then
  info "Linting shell scripts (shellcheck) …"
  if find scripts/ hooks/ \( -name "*.sh" -o -name "pre-commit" \) -print0 | xargs -0 shellcheck; then
    pass "Shell scripts OK"
  else
    fail "shellcheck found issues. Fix the errors above before committing."
    exit 1
  fi
else
  info "shellcheck not found — skipping (install with: brew install shellcheck)"
fi

# ---------------------------------------------------------------------------
# Step 6: Tests (uv run pytest — mirrors CI)
# Note: using pytest directly avoids ambiguity with the shell builtin `test`.
# ---------------------------------------------------------------------------
info "Running tests …"
if uv run --no-sync python -m pytest -rs --cov --cov-report=term-missing; then
  pass "Tests passed"
else
  fail "Tests failed."
  exit 1
fi

echo -e "\n${GREEN}${BOLD}All checks passed.${RESET}"
