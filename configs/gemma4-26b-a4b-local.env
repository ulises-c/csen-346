# Experiment: Gemma 4 26B A4B-it (Unsloth UD-Q5_K_XL GGUF) — fully local, dual-role.
#
# Both teacher and consultant hit the same llama.cpp server on port 8080,
# mirroring the Qwen 27B local pattern. ~17 GB VRAM (MoE, ~4B active) at 200K context on the
# RTX 5090 (~2.6 GB headroom). 6 parallel slots handle teacher+consultant
# concurrency through one process.
#
# Boot the server with:   make serve-gemma4-26b-a4b
# Eval orchestrator:      ./scripts/eval_gemma4_31b.sh smoke
#
# Shares port 8080 with all other llama.cpp configs (qwen27b-local,
# qwen35b-a3b-local, etc.) — only one model can run at a time.

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Gemma 4 26B A4B
# 8192 leaves ample room for structured JSON output. Gemma 4 has no
# thinking-mode equivalent (Qwen-specific feature) so no CoT budget needed.
CONSULTANT_MAX_TOKENS=8192
# CONSULTANT_NUM_CTX intentionally unset — Ollama-only knob; llama.cpp ignores it.

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Gemma 4 26B A4B

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
