# Experiment: Qwen3.6-35B-A3B (MoE) Q4_K_M — fully local, dual-role.
#
# Both teacher and consultant hit the same llama.cpp server on port 8080.
# A3B activates only ~3B of 35B params per token, so inference is ~3-4x faster
# than the dense 27B. KV cache is also ~3x more efficient (~6.3 vs ~18
# KB/token), leaving ~9 GB VRAM headroom.
#
# Boot the server with:   make serve-qwopus35b-a3b
# Eval orchestrator:      ./scripts/eval_qwen35b_a3b.sh smoke
#
# This config shares the same port as qwen27b-local — only one can run at a time.

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwopus 35B A3B
# 8192 leaves ample room for thinking-mode CoT + structured JSON output.
CONSULTANT_MAX_TOKENS=8192
# CONSULTANT_NUM_CTX intentionally unset — Ollama-only knob; llama.cpp ignores it.

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwopus 35B A3B

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
