# Training outputs — checkpoints, logs, and eval results can be multi-GB
outputs/
results/
logs/
wandb/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Coverage (coverage.py local cache + exported reports)
# `.coverage` is a SQLite cache regenerated by every test run — local-only.
# Codecov ingests the exported XML, not the raw cache.
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Virtual envs
.venv/
*.egg-info/
dist/
.eggs/

# HuggingFace cache (if symlinked here)
.cache/

# Coverage
.coverage
htmlcov/

# Data — generated / large files not suited for git
data/SocratDataset-EN.json
data/translate.log
data/translate_checkpoint.json
data/archive/
# Translation-validation raw outputs — regenerable; keep only flagged + structural summaries
data/translation_validation/validate_llm_checkpoint_*.json
data/translation_validation/validate_llm_scores_*.json

# Secrets and local tooling
.env
.claude/
.railguard/

# Editor
.idea/
.vscode/
*.swp
# BERT/Qwen classifier artifacts — too large for git; regenerate via
# scripts/train_state_classifier_34way.py (or train_stage_classifier.py).
# Wildcard pattern covers all current + future state-classifier output dirs.
results/stage_classifier_*/checkpoints/
results/stage_classifier_*/final/
results/state_classifier_*/checkpoints/
results/state_classifier_*/final/
results/state-clf-*/checkpoints/
results/state-clf-*/final/
references/KELE-EN/SocratDataset.json
references/KELE-EN/data/
references/KELE-EN/.cache/


# Railguard
.railguard/*

# W&B local run artifacts
wandb/
# macOS
.DS_Store
**/.DS_Store

# Chainlit auto-generated default translations (regenerated on run),
# except en-US.json which we customize (e.g. the README header label).
.chainlit/translations/*
!.chainlit/translations/en-US.json
